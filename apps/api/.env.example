# Required. The service refuses to boot without these.
DATABASE_URL="postgres://monitoring:monitoring@localhost:5442/monitoring?sslmode=disable"
JWT_SECRET="change-me-at-least-32-characters-long-secret"
WEBHOOK_SECRET="change-me-room-alert-hmac-secret"

# Optional.
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ACCESS_TOKEN_TTL=8h
DEVICE_TOKEN_TTL=720h
UPLOAD_DIR=./data/uploads

# The broker the AKCP sensorProbe+ units publish to. Leave MQTT_BROKER_URL empty and the
# subscriber stays off, which is how an install with only Room Alert units runs.
MQTT_BROKER_URL="tcp://localhost:1883"
# Left empty, the client id is akcp-<hostname>, which differs per machine and survives restarts.
# Set it only when two instances share a hostname: the broker kicks the older session when a
# second client connects with the same id, and both then reconnect in a loop.
MQTT_CLIENT_ID=
MQTT_TOPIC_FILTER=spp/+/sensor/+/+
MQTT_USERNAME=
MQTT_PASSWORD=
