# Required. The API refuses to boot without these.
DATABASE_URL="postgresql://monitoring:monitoring@localhost:5432/monitoring?schema=public"
JWT_SECRET="change-me-at-least-32-characters-long-secret"
WEBHOOK_SECRET="change-me-room-alert-hmac-secret"

# Optional.
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Without REDIS_URL the queue runs handlers inline, which is fine for local development.
# REDIS_URL="redis://localhost:6379"
