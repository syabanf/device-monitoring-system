# Copy to .env to change what `docker compose` publishes. Every value has a default.

# Host port for the API. 3000 is what `pnpm dev:api` uses, so the stack takes 3300.
API_PORT=3300
# What the browser calls, so a host address rather than the compose service name.
API_URL=http://localhost:3300

APP_ENV=development
LOG_LEVEL=info
JWT_SECRET=change-me-at-least-32-characters-long-secret
WEBHOOK_SECRET=local-webhook-secret
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:5173,http://localhost:5174
