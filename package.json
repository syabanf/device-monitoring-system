{
  "name": "monitoring-system",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo dev",
    "dev:admin": "turbo dev --filter=@monitoring/admin",
    "dev:mobile": "turbo dev --filter=@monitoring/mobile",
    "build": "turbo build",
    "preview:mobile": "pnpm --filter @monitoring/mobile preview",
    "preview:admin": "pnpm --filter @monitoring/admin preview",
    "typecheck": "turbo typecheck",
    "format": "prettier -w .",
    "gen:fixtures": "tsx scripts/generate-fixtures.ts",
    "dev:api": "turbo dev --filter=@monitoring/api",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @monitoring/api db:migrate",
    "db:seed": "pnpm --filter @monitoring/api db:seed",
    "infra:up": "docker compose up -d postgres redis mailpit",
    "infra:down": "docker compose down",
    "stack:up": "docker compose up -d --build",
    "stack:seed": "docker compose run --rm seed",
    "stack:logs": "docker compose logs -f api admin mobile",
    "stack:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
